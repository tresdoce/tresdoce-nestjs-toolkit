    "@nestjs/microservices": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "@tresdoce-nestjs-toolkit/core": "^3.0.0-beta.0",
    "@tresdoce-nestjs-toolkit/tracing": "^3.0.0-beta.0",
    "ioredis": "^6.0.0",
    "lodash": "^4.18.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@tresdoce-nestjs-toolkit/config": "^1.0.0-beta.0",
