{
  "name": "@tresdoce-nestjs-toolkit/auth",
  "version": "0.2.0",
  "description": "Tresdoce NestJS Toolkit - Módulo de autenticación JWT con roles y refresh tokens",
  "author": {
    "name": "Maximiliano \"Mex\" Delgado",
    "email": "mdelgado@tresdoce.com.ar",
    "url": "https://rudemex.github.io/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "keywords": [
    "nestjs",
    "auth",
    "jwt",
    "passport",
    "refresh-token"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresdoce/tresdoce-nestjs-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/tresdoce/tresdoce-nestjs-toolkit/issues"
  },
  "homepage": "https://github.com/tresdoce/tresdoce-nestjs-toolkit#readme",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf ../../dist/auth",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-dist-package.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware src",
    "clean": "rimraf .turbo coverage test-results reports node_modules test-report.xml junit.xml debug.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/auth"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@tresdoce-nestjs-toolkit/core": "^2.1.0",
    "@tresdoce-nestjs-toolkit/redis": "^2.0.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@tresdoce-nestjs-toolkit/config": "^0.5.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/tresdoce-nestjs-toolkit": "^0.3.3"
  },
  "type": "module"
}
