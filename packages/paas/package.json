{
  "name": "@tresdoce-nestjs-toolkit/paas",
  "version": "3.0.0-beta.0",
  "description": "Tresdoce NestJS Toolkit - Librería centralizada de funcionalidades cross",
  "author": {
    "name": "Maximiliano \"Mex\" Delgado",
    "email": "mdelgado@tresdoce.com.ar",
    "url": "https://rudemex.github.io/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "keywords": [
    "nestjs",
    "paas",
    "cross"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresdoce/tresdoce-nestjs-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/tresdoce/tresdoce-nestjs-toolkit/issues"
  },
  "homepage": "https://github.com/tresdoce/tresdoce-nestjs-toolkit#readme",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf ../../dist/paas",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-dist-package.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware src",
    "clean": "rimraf .turbo coverage test-results reports node_modules test-report.xml junit.xml debug.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/paas"
  },
  "dependencies": {
    "@tresdoce-nestjs-toolkit/core": "^3.0.0-beta.0",
    "@tresdoce-nestjs-toolkit/filters": "^3.0.0-beta.0",
    "@tresdoce-nestjs-toolkit/health": "^3.0.0-beta.0",
    "@tresdoce-nestjs-toolkit/logger": "^1.0.0-beta.0",
    "@tresdoce-nestjs-toolkit/rate-limit": "^1.0.0-beta.0",
    "@tresdoce-nestjs-toolkit/response-parser": "^3.0.0-beta.0",
    "@tresdoce-nestjs-toolkit/tracing": "^3.0.0-beta.0",
    "@tresdoce-nestjs-toolkit/utils": "^3.0.0-beta.0"
  },
  "devDependencies": {
    "@tresdoce-nestjs-toolkit/config": "^1.0.0-beta.0",
    "@types/tresdoce-nestjs-toolkit": "^1.0.0-beta.0"
  },
  "type": "module"
}
