{
  "name": "@tresdoce-nestjs-toolkit/core",
  "version": "2.1.0",
  "description": "Tresdoce NestJS Toolkit - Funcionalidades a nivel core",
  "author": {
    "name": "Maximiliano \"Mex\" Delgado",
    "email": "mdelgado@tresdoce.com.ar",
    "url": "https://rudemex.github.io/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "keywords": [
    "nestjs",
    "core"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresdoce/tresdoce-nestjs-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/tresdoce/tresdoce-nestjs-toolkit/issues"
  },
  "homepage": "https://github.com/tresdoce/tresdoce-nestjs-toolkit#readme",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf ../../dist/core",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-dist-package.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware src",
    "clean": "rimraf .turbo coverage test-results reports node_modules test-report.xml junit.xml debug.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/core"
  },
  "dependencies": {
    "@nestjs/class-transformer": "^0.4.0",
    "@nestjs/class-validator": "^0.13.4",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.1",
    "cookie-signature": "^1.2.2",
    "csrf": "^3.1.0",
    "joi": "^18.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tresdoce-nestjs-toolkit/config": "^0.5.5",
    "@types/tresdoce-nestjs-toolkit": "^0.3.3"
  },
  "type": "module"
}
