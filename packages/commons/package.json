{
  "name": "@tresdoce-nestjs-toolkit/commons",
  "version": "2.0.0-beta.0",
  "description": "Tresdoce NestJS Toolkit - Configuraciones compartidas (Vitest y oxlint)",
  "author": {
    "name": "Maximiliano \"Mex\" Delgado",
    "email": "mdelgado@tresdoce.com.ar",
    "url": "https://rudemex.github.io/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "keywords": [
    "nestjs",
    "commons"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresdoce/tresdoce-nestjs-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/tresdoce/tresdoce-nestjs-toolkit/issues"
  },
  "homepage": "https://github.com/tresdoce/tresdoce-nestjs-toolkit#readme",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf ../../dist/commons",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-dist-package.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware src",
    "clean": "rimraf .turbo coverage test-results reports node_modules test-report.xml junit.xml debug.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/commons"
  },
  "dependencies": {
    "@vitest/coverage-istanbul": "^5.0.5",
    "magic-string": "^1.4.3",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "devDependencies": {
    "@tresdoce-nestjs-toolkit/config": "^1.0.0-beta.0",
    "@types/tresdoce-nestjs-toolkit": "^1.0.0-beta.0"
  },
  "type": "module",
  "peerDependencies": {
    "oxlint": ">=1.0.0",
    "oxlint-tsgolint": ">=7.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
