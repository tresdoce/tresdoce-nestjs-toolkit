{
  "name": "@tresdoce-nestjs-toolkit/typeorm",
  "version": "3.0.0",
  "description": "Tresdoce NestJS Toolkit - Módulo de ORM para base de datos",
  "author": {
    "name": "Maximiliano \"Mex\" Delgado",
    "email": "mdelgado@tresdoce.com.ar",
    "url": "https://rudemex.github.io/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "keywords": [
    "nestjs",
    "typeorm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresdoce/tresdoce-nestjs-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/tresdoce/tresdoce-nestjs-toolkit/issues"
  },
  "homepage": "https://github.com/tresdoce/tresdoce-nestjs-toolkit#readme",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf ../../dist/typeorm",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-dist-package.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware src",
    "clean": "rimraf .turbo coverage test-results reports node_modules test-report.xml junit.xml debug.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/typeorm"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/typeorm": "^12.0.2",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@tresdoce-nestjs-toolkit/config": "^1.0.0",
    "@types/tresdoce-nestjs-toolkit": "^1.0.0"
  },
  "type": "module"
}
