{
  "name": "@tresdoce-nestjs-toolkit/mailer",
  "version": "2.0.12-beta.0",
  "description": "Tresdoce NestJS Toolkit - Módulo para envíos de mail",
  "author": {
    "name": "Maximiliano \"Mex\" Delgado",
    "email": "mdelgado@tresdoce.com.ar",
    "url": "https://rudemex.github.io/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "keywords": [
    "nestjs",
    "mailer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresdoce/tresdoce-nestjs-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/tresdoce/tresdoce-nestjs-toolkit/issues"
  },
  "homepage": "https://github.com/tresdoce/tresdoce-nestjs-toolkit#readme",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf ../../dist/mailer",
    "build": "pika build --out ../../dist/mailer",
    "test": "cross-env NODE_OPTIONS=--no-deprecation YARN_CACHE_FOLDER=.yarn-cache jest --runInBand --coverage",
    "clean": "rimraf .turbo coverage test-results reports node_modules test-report.xml junit.xml debug.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/mailer"
  },
  "dependencies": {
    "@css-inline/css-inline": "^0.20.2",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "ejs": "^6.0.1",
    "glob": "13.0.6",
    "handlebars": "^4.7.9",
    "mjml": "^5.3.0",
    "nodemailer": "8.0.10",
    "pug": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@tresdoce-nestjs-toolkit/config": "^0.5.5-beta.0",
    "@types/tresdoce-nestjs-toolkit": "^0.3.3"
  },
  "prettier": {
    "semi": true,
    "tabWidth": 2,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "@pika/pack": {
    "pipeline": [
      [
        "@pika/plugin-ts-standard-pkg",
        {
          "exclude": [
            "**/__test__/*"
          ]
        }
      ],
      [
        "@pika/plugin-build-node",
        {
          "exclude": [
            "**/__test__/*"
          ]
        }
      ],
      [
        "pika-plugin-package.json",
        {
          "*files": [
            "-bin/",
            "-dist-*/",
            "+dist-*/*",
            "+CHANGELOG.md",
            "+LICENSE.md",
            "+package.json",
            "+README.md"
          ]
        }
      ]
    ]
  }
}
