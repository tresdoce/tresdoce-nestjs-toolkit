{
  "name": "@tresdoce-nestjs-toolkit/root",
  "description": "Tresdoce NestJS Toolkit",
  "author": {
    "name": "Maximiliano \"Mex\" Delgado",
    "email": "mdelgado@tresdoce.com.ar",
    "url": "https://rudemex.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresdoce/tresdoce-nestjs-toolkit.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tresdoce/tresdoce-nestjs-toolkit/issues"
  },
  "homepage": "https://github.com/tresdoce/tresdoce-nestjs-toolkit#readme",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "turbo run build --concurrency=1",
    "test": "turbo run test --concurrency=1",
    "clean": "turbo run clean --concurrency=1",
    "preclean": "lerna clean -y",
    "postclean": "rimraf ./yarn.lock ./package-lock.json ./dist ./.turbo ./node_modules",
    "lint": "oxlint --type-aware --fix packages",
    "lint:check": "oxlint --type-aware packages",
    "format": "prettier --write './packages/**/*.{ts,tsx,js,jsx,json,json5,jsonc,yml,yaml,md,mdx}'",
    "format:check": "prettier --check './packages/**/*.{ts,tsx,js,jsx,json,json5,jsonc,yml,yaml,md,mdx}'",
    "lint:format:check": "yarn lint:check && yarn format:check",
    "pre-commit": "lint-staged",
    "prepublishOnly": "yarn build",
    "version:prerelease": "lerna version --conventional-commits --no-changelog --conventional-prerelease --no-git-tag-version --preid=beta --yes",
    "version:release": "lerna version --conventional-commits --force-git-tag --create-release github --conventional-graduate --yes",
    "publish:pkgs": "lerna publish from-package --no-verify-access --yes",
    "plop": "plop",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": "@commitlint/config-conventional"
  },
  "prettier": {
    "semi": true,
    "tabWidth": 2,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,json5,jsonc,yml,yaml,md,mdx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/class-transformer": "^0.4.0",
    "@nestjs/class-validator": "^0.13.4",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.2.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "camunda-external-task-client-js": "^2.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dynamoose": "^4.2.0",
    "dynamoose-logger": "^4.2.0",
    "fast-redact": "^3.5.0",
    "joi": "^18.3.0",
    "kafkajs": "^2.2.4",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "minimatch": "^10.2.6",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.4",
    "mysql2": "^3.24.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "testcontainers": "^12.2.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@elastic/elasticsearch-mock": "^2.1.0",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/camunda-external-task-client-js": "^1.3.6",
    "@types/cookie": "^0.6.0",
    "@types/cookie-signature": "^1.1.2",
    "@types/ejs": "^3.1.5",
    "@types/elasticsearch": "^5.0.43",
    "@types/express": "^5.0.6",
    "@types/fast-redact": "^3.0.4",
    "@types/inline-css": "^3.0.3",
    "@types/lodash": "^4.17.24",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pug": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "gulp": "^5.0.1",
    "gulp-shell": "^0.8.0",
    "husky": "^9.1.7",
    "lerna": "^10.0.0",
    "lint-staged": "^17.0.7",
    "nock": "^14.0.17",
    "nodemailer-mock": "^2.0.11",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "plop": "^4.0.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.2.1",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "type": "module"
}
